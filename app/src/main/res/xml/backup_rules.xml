<?xml version="1.0" encoding="utf-8"?>
<!-- Используется на API < 31. На API 31+ применяется data_extraction_rules.xml -->
<full-backup-content>
    <!-- DataStore содержит конфиги профилей и настройки — не бэкапим -->
    <exclude domain="file" path="datastore/"/>
    <!-- Вход в Mail.ru (MailruSignIn) и его копия в хранилище cookies ядра OpenFlux -->
    <exclude domain="file" path="mailru_signin.json"/>
    <exclude domain="file" path="cookies-mailru.json"/>
</full-backup-content>
